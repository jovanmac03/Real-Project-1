body {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  color: #333;
  background-color: White;
  margin: 0;
  padding: 0;
}

/* Header */
header {
  text-align: center;
  padding: 20px;
  background-color: #White;
  color: Black;
}

header img {
  max-width: 100%;
  height: auto;
  margin-top: 10px;
  border-radius: 8px;
}

/* Sections */
section {
  max-width: 800px;
  margin: 30px auto;
  padding: 20px;
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

/* Headings */
h1, h2 {
  margin-bottom: 15px;
}

/* Lists */
ul {
  padding-left: 20px;
  margin-bottom: 15px;
}

li {
  margin-bottom: 8px;
}

/* Links */
a {
  color: Vlue;
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

/* Footer */
footer {
  text-align: center;
  padding: 15px;
  background-color: White;
  color: Blue;
  margin-top: 40px;
}
